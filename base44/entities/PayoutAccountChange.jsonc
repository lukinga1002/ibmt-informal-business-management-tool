{
  "name": "PayoutAccountChange",
  "type": "object",
  "properties": {
    "disclosure_version": {
      "type": "string",
      "description": "Version of the withdrawal disclosure the owner confirmed"
    },
    "withdrawn_by": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "landlord_name": {
      "type": "string"
    },
    "old_phone_masked": {
      "type": "string",
      "description": "The number on file, masked. The OTP goes to this number, never to the new one."
    },
    "new_phone_masked": {
      "type": "string"
    },
    "new_phone_last4": {
      "type": "string",
      "description": "Last four digits only, enough for a person to recognise the number"
    },
    "challenge_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "otp_sent",
        "verified",
        "cooling_off",
        "effective",
        "rejected"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "requested"
    },
    "cooling_off_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "The change cannot take effect before this moment"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "property_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "account_type": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "name_check": {
      "type": "string"
    },
    "consent_version": {
      "type": "string"
    },
    "roster_id": {
      "type": "string"
    },
    "old_account_id": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "consent": {
      "type": "boolean"
    },
    "simulation": {
      "type": "boolean",
      "default": true
    },
    "cooling_off_hours": {
      "type": "number"
    }
  },
  "required": [
    "landlord_id",
    "new_phone_masked",
    "status"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
