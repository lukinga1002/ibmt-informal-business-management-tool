{
  "name": "PayoutAccountChange",
  "type": "object",
  "properties": {
    "landlord_id": {
      "type": "string"
    },
    "landlord_name": {
      "type": "string"
    },
    "old_phone_masked": {
      "type": "string",
      "description": "The number on file, masked. The OTP goes to this number, never to the new one."
    },
    "new_phone_masked": {
      "type": "string"
    },
    "new_phone_last4": {
      "type": "string",
      "description": "Last four digits only, enough for a person to recognise the number"
    },
    "challenge_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "otp_sent",
        "verified",
        "cooling_off",
        "effective",
        "rejected"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "requested"
    },
    "cooling_off_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "The change cannot take effect before this moment"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "landlord_id",
    "new_phone_masked",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}