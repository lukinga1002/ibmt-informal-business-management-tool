{
  "name": "AgentCommission",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "mandate_id": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "unit_ref": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Commission in TZS, owed by the landlord side only. Always zero on a renewal."
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_tenancy",
        "renewal"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "description": "Stage 1: commission is earned on a new tenancy only."
    },
    "status": {
      "type": "string",
      "enum": [
        "accrued",
        "paid",
        "reversed",
        "zero_renewal"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "accrued"
    },
    "note": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "mandate_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.ibmt_role": "tra_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}