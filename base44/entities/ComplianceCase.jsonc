{
  "name": "ComplianceCase",
  "type": "object",
  "properties": {
    "subject_type": {
      "type": "string",
      "enum": [
        "unit",
        "landlord",
        "agent",
        "listing"
      ]
    },
    "subject_reference": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "e.g. unverified ownership, unlicensed agent, unlisted rent increase"
    },
    "note": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "escalated"
      ],
      "default": "open"
    }
  },
  "required": [
    "subject_type",
    "subject_reference",
    "district",
    "ward"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "district_official"
              }
            },
            {
              "data.district": "{{user.data.district}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.ibmt_role": "tra_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.ibmt_role": "district_official"
          }
        },
        {
          "user_condition": {
            "data.ibmt_role": "mtaa_officer"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "district_official"
              }
            },
            {
              "data.district": "{{user.data.district}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}