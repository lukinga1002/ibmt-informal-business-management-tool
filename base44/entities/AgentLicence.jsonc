{
  "name": "AgentLicence",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "council_id": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "licence_no": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "decided_by": {
      "type": "string"
    },
    "decision_note": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "agent_id",
    "agent_name",
    "district"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}