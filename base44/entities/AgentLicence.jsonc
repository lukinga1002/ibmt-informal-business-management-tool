{
  "name": "AgentLicence",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string",
      "description": "The broker's own name, as they wrote it on the application"
    },
    "agent_phone": {
      "type": "string",
      "description": "The broker's phone number, required so the council can reach them about the licence"
    },
    "agent_email": {
      "type": "string",
      "description": "The broker's email, optional. Empty when they did not give one."
    },
    "nida_number": {
      "type": "string",
      "description": "The broker's NIDA national identity number: twenty digits, asked at registration and read by the council when it decides."
    },
    "business_name": {
      "type": "string",
      "description": "The brokerage's trading name, when the broker has one. Optional: a broker may work under their own name."
    },
    "council_id": {
      "type": "string"
    },
    "council_name": {
      "type": "string",
      "description": "Denormalized council name, so a public check can answer with the council and nothing else."
    },
    "region": {
      "type": "string",
      "description": "Region the council sits in, chosen by the broker before the district"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "rental",
        "sale",
        "both"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "rental",
      "description": "What this broker is registered to handle in this council. A rental-scope broker cannot be named on a rental mandate; sale records arrive with A1."
    },
    "licence_no": {
      "type": "string",
      "description": "Serial licence number, e.g. IBMT-AGL-2026-0014. Issued only on approval, and one per broker per council."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended",
        "revoked"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "red",
        "red"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "description": "What the applicant wrote when applying"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_reason": {
      "type": "string",
      "description": "Required for reject, suspend and revoke"
    },
    "decision_note": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Every decision in order, with its reason and time",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "agent_id",
    "agent_name",
    "district"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}