{
  "name": "ApprovalRequest",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "refund",
        "reverse",
        "payout_override",
        "retention_run"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "payload": {
      "type": "object",
      "description": "What the action would do, frozen when it is requested"
    },
    "requested_by_id": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "required_approvals": {
      "type": "number",
      "default": 1,
      "description": "One approver, who must be a different person from the requester"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "by_id": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "executed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "green"
      ],
      "default": "pending"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "action",
    "requested_by_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requested_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}