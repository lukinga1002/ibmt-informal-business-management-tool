{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "anonymised",
        "refused"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "requested"
    },
    "anonymised_fields": {
      "type": "array",
      "description": "What was replaced with a neutral value",
      "items": {
        "type": "string"
      }
    },
    "retained": {
      "type": "array",
      "description": "What is kept, and the reason it is kept",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "anonymised_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "subject_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.subject_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.subject_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}