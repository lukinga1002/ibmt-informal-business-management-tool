{
  "name": "Lease",
  "type": "object",
  "properties": {
    "lease_ref": {
      "type": "string",
      "description": "Serial reference, e.g. IBMT-LSE-2026-000214"
    },
    "tenancy_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "One tenancy = one unit = one active lease. The backend refuses a second open lease on a unit."
    },
    "unit_ref": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string",
      "description": "Bound when the tenant claims the lease from their own account, or at creation when the account is already known."
    },
    "agent_id": {
      "type": "string",
      "description": "Agent under an active mandate when the lease was signed. Agents never read rent history."
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "mtaa": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "rent_amount": {
      "type": "number",
      "description": "Agreed rent per period as a whole number of shillings"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "monthly"
    },
    "terms": {
      "type": "object",
      "description": "The bilingual clauses the lease was created from, plus the figures they carry"
    },
    "template_version": {
      "type": "string",
      "description": "Standard template version this lease was built from, e.g. lease-2026.1-draft. Stored on the lease so a later template change never rewrites a signed lease."
    },
    "template_state": {
      "type": "string",
      "enum": [
        "draft_pending_legal_review",
        "reviewed"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "draft_pending_legal_review",
      "description": "draft_pending_legal_review = the standard template has not been through legal review yet."
    },
    "template_label": {
      "type": "object",
      "description": "The wording shown on the lease itself, e.g. DRAFT \u2014 pending legal review"
    },
    "stamp_duty": {
      "type": "object",
      "description": "Placeholder only. No amount is ever calculated or claimed in Stage 1."
    },
    "verify_code": {
      "type": "string",
      "description": "Long random code behind the QR on the lease, used by the public check page"
    },
    "claim_code": {
      "type": "string",
      "description": "Code the landlord hands the tenant so the tenant's own account is bound to the lease before signing. Cleared once claimed."
    },
    "otp": {
      "type": "object",
      "description": "One signing challenge at a time: the party, the code and its expiry"
    },
    "lease_version": {
      "type": "number",
      "description": "Lease version incremented on every amendment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_tenant",
        "awaiting_signature",
        "signed",
        "amended",
        "terminated"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "yellow",
        "green",
        "blue",
        "red"
      ],
      "default": "draft"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party": {
            "type": "string",
            "enum": [
              "landlord",
              "tenant"
            ]
          },
          "method": {
            "type": "string"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client action key: a retried submit returns the lease that already exists"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "lease_ref",
    "unit_id",
    "landlord_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.landlord_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}