{
  "name": "Lease",
  "type": "object",
  "properties": {
    "lease_ref": {
      "type": "string",
      "description": "Serial reference, e.g. IBMT-LSE-2026-000214"
    },
    "tenancy_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "One tenancy = one unit = one active lease. The backend refuses a second active lease on a unit."
    },
    "unit_ref": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent under an active mandate when the lease was signed. Agents never read rent history."
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "rent_amount": {
      "type": "number",
      "description": "Agreed monthly rent as a whole number of shillings"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "terms": {
      "type": "object",
      "description": "Lease terms: rent, interval, deposit, notice period, obligations, bilingual clauses"
    },
    "lease_version": {
      "type": "number",
      "description": "Lease version incremented on every amendment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_signature",
        "signed",
        "amended",
        "terminated"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "blue",
        "red"
      ],
      "default": "draft"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party": {
            "type": "string",
            "enum": [
              "landlord",
              "tenant"
            ]
          },
          "method": {
            "type": "string"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "stamp_duty_assessment": {
      "type": "object",
      "description": "Stamp duty computed by the backend from the active policy version",
      "properties": {
        "amount": {
          "type": "number"
        },
        "basis": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        }
      }
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "unit_id",
    "landlord_id",
    "tenant_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}