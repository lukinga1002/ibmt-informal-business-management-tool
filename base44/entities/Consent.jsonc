{
  "name": "Consent",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "User id the consent belongs to; always the creator"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "core_service",
        "council_sharing",
        "listings",
        "rent_history_credit"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "yellow"
      ],
      "description": "One row per purpose. The four choices are never bundled: core service, sharing building and registration data with the council, listings, rent history for credit."
    },
    "granted": {
      "type": "boolean",
      "default": false,
      "description": "Current state of this one purpose. Withdrawing sets it false and stamps withdrawn_at; it does not delete the row."
    },
    "version": {
      "type": "string",
      "description": "Wording version the person agreed to, so a later change of words is visible"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "subject_id",
    "purpose",
    "version"
  ],
  "rls": {
    "read": {
      "data.subject_id": "{{user.id}}"
    },
    "create": {
      "data.subject_id": "{{user.id}}"
    },
    "update": {
      "data.subject_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}