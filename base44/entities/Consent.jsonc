{
  "name": "Consent",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "User id the consent belongs to; always the creator"
    },
    "registration_processing": {
      "type": "boolean",
      "default": true
    },
    "listing_marketing": {
      "type": "boolean",
      "default": false
    },
    "rent_history_credit": {
      "type": "boolean",
      "default": false
    },
    "lender_sharing": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "subject_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}