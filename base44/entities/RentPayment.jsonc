{
  "name": "RentPayment",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Rent record reference, e.g. IBMT-RPT-2026-000921"
    },
    "tenancy_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_ref": {
      "type": "string",
      "description": "Unit serial reference, denormalized for display"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "period_month": {
      "type": "string",
      "description": "Rent period the record covers, e.g. 2026-11"
    },
    "period_months": {
      "type": "number",
      "description": "Months of rent the record covers"
    },
    "amount": {
      "type": "number",
      "description": "Rent as a whole number of shillings. Never a decimal."
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit share as a whole number of shillings"
    },
    "tenant_total": {
      "type": "number",
      "description": "Total the tenant paid: rent plus deposit, computed by the backend"
    },
    "new_tenancy": {
      "type": "boolean",
      "description": "True when the record opens a new tenancy"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "mobile_money",
        "bank_transfer",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray",
        "gray"
      ],
      "description": "How the money moved. Stage 1 records it; IBMT never holds funds."
    },
    "mobile_money_ref": {
      "type": "string",
      "description": "Mobile-money or bank reference the payer quotes, kept exactly as entered"
    },
    "paid_on": {
      "type": "string",
      "format": "date",
      "description": "The date the payer says the money moved"
    },
    "withholding_amount": {
      "type": "number",
      "description": "Dormant in Stage 1. Set only under a confirmed TaxRule."
    },
    "platform_fee": {
      "type": "number",
      "description": "Landlord-side service fee, whole shillings. Never deducted from tenant funds."
    },
    "agent_commission": {
      "type": "number",
      "description": "Paid by the landlord side, never deducted from tenant funds"
    },
    "net_to_landlord": {
      "type": "number"
    },
    "record_status": {
      "type": "string",
      "enum": [
        "pending",
        "recorded",
        "confirmed",
        "disputed",
        "unconfirmed"
      ],
      "enumColors": [
        "yellow",
        "gray",
        "green",
        "red",
        "gray"
      ],
      "default": "pending",
      "description": "Stage 1 lifecycle. One party enters the record, the other confirms or disputes it; only a confirmed record produces a receipt reference."
    },
    "entered_by_id": {
      "type": "string"
    },
    "entered_by_role": {
      "type": "string",
      "enum": [
        "landlord",
        "tenant"
      ],
      "description": "Who entered the record. The other party is the one who confirms it."
    },
    "entered_by_name": {
      "type": "string"
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_by_id": {
      "type": "string"
    },
    "confirmed_by_name": {
      "type": "string"
    },
    "disputed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispute_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "quoted",
        "pending",
        "settled",
        "failed",
        "refunded"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red",
        "purple"
      ],
      "default": "pending",
      "description": "Dormant in Stage 1: the movement of money returns in Stage 2. Do not read this for Stage 1 state; read record_status."
    },
    "receipt_reference": {
      "type": "string",
      "description": "Issued at the moment of confirmation, including a late confirmation, and never earlier."
    },
    "receipt_issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "sms_state": {
      "type": "string",
      "description": "not_sent | queued_gateway_off. Says plainly whether the SMS left the system."
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client action key: a retried submit can never record the same payment twice"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "reference",
    "tenancy_id",
    "amount",
    "record_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}