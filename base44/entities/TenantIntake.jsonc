{
  "name": "TenantIntake",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "unit_ref": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string",
      "description": "Landlord the intake belongs to. Null when an agent recorded it."
    },
    "agent_id": {
      "type": "string",
      "description": "Agent who recorded the intake. Null when the landlord did."
    },
    "entered_by_role": {
      "type": "string",
      "enum": [
        "landlord",
        "agent"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "tenant_name": {
      "type": "string"
    },
    "tenant_phone": {
      "type": "string"
    },
    "nida_number": {
      "type": "string",
      "description": "The tenant's NIDA national identity number: twenty digits, required before the tenant is recorded."
    },
    "rent_amount": {
      "type": "number",
      "description": "Agreed rent as a whole number of shillings"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "converted",
        "cancelled"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "recorded",
      "description": "recorded = tenant details captured. A tenancy is only created once the tenant confirms on their own account."
    },
    "council_id": {
      "type": "string"
    },
    "council_name": {
      "type": "string",
      "description": "Council named in the notice sent to the tenant"
    },
    "owner_name": {
      "type": "string",
      "description": "Owner named in the notice sent to the tenant"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "notice_channel": {
      "type": "string",
      "default": "sms"
    },
    "notice_state": {
      "type": "string",
      "enum": [
        "not_sent",
        "queued_gateway_off",
        "sent"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "not_sent",
      "description": "Says plainly whether the tenant notice left the system. No SMS gateway is connected in this stage, so a recorded intake is queued, not sent."
    },
    "notice_text": {
      "type": "string",
      "description": "The notice as sent to the tenant, Swahili"
    },
    "notice_text_en": {
      "type": "string",
      "description": "The same notice in English"
    },
    "notice_to_masked": {
      "type": "string",
      "description": "The number the notice goes to, masked"
    },
    "notice_at": {
      "type": "string",
      "format": "date-time"
    },
    "occupation": {
      "type": "string"
    },
    "tenant_email": {
      "type": "string"
    },
    "contract_months": {
      "type": "integer",
      "minimum": 1
    },
    "unit_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_name",
    "tenant_phone",
    "nida_number",
    "entered_by_role",
    "occupation",
    "contract_months",
    "rent_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.ibmt_role": "landlord"
          }
        },
        {
          "user_condition": {
            "data.ibmt_role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
