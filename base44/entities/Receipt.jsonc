{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Serial number issued by the backend, e.g. IBMT-RCP-2026-000118"
    },
    "business_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "district": {
      "type": "string",
      "description": "Business district, denormalized for jurisdiction-scoped official access"
    },
    "issued_on": {
      "type": "string",
      "format": "date"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_contact": {
      "type": "string"
    },
    "buyer_ref": {
      "type": "string",
      "description": "Consumer reference, when the buyer is a registered IBMT subject"
    },
    "total": {
      "type": "number",
      "description": "Total in TZS, computed by the backend from lines"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "awaiting_confirmation",
        "confirmed",
        "void"
      ],
      "default": "draft"
    },
    "buyer_confirmation": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_confirmation",
        "confirmed"
      ],
      "default": "draft"
    },
    "confirmation_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Buyer confirmation window from the active policy version"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fiscal_status": {
      "type": "string",
      "enum": [
        "unreported",
        "reported"
      ],
      "default": "unreported"
    },
    "version": {
      "type": "number",
      "description": "Optimistic-concurrency version incremented by the backend on every change"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client action key: a retried submit can never create a second receipt"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_amount": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        },
        "required": [
          "description",
          "qty",
          "unit_amount",
          "line_total"
        ]
      }
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "reference",
    "business_id",
    "issued_on",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.ibmt_role": "tra_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "district_official"
              }
            },
            {
              "data.district": "{{user.data.district}}"
            }
          ]
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}