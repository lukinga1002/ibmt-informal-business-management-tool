{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "deposit_id": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "repairs",
        "entry",
        "notice",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray",
        "gray"
      ]
    },
    "opened_by_role": {
      "type": "string",
      "enum": [
        "landlord",
        "tenant"
      ]
    },
    "opened_by_id": {
      "type": "string"
    },
    "body": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "mediation",
        "resolved",
        "escalated",
        "closed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red",
        "gray"
      ],
      "default": "open"
    },
    "escalated_to": {
      "type": "string",
      "description": "Who the case was escalated to, e.g. district_commissioner"
    },
    "evidence_pack_id": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "description": "Every step with its own timestamp",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "by_role": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "resolution_note": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    },
    "council_id": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "kind",
    "district",
    "ward"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}