{
  "name": "SimCouncilBill",
  "type": "object",
  "properties": {
    "council_id": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "control_number": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "amount": {
      "type": "number"
    },
    "state": {
      "type": "string"
    },
    "settled_at": {
      "type": "string"
    },
    "revision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "council_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
