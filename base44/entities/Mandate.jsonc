{
  "name": "Mandate",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "fee_basis": {
      "type": "string",
      "enum": [
        "monthly_flat",
        "share_of_rent"
      ],
      "default": "monthly_flat"
    },
    "fee_amount": {
      "type": "number",
      "description": "Commission payable by the landlord only, as whole shillings, per the active policy version"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "starts_on": {
      "type": "string",
      "format": "date"
    },
    "ends_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "active",
        "ended"
      ],
      "default": "offered",
      "description": "Only an active mandate gives the agent sight of the unit. Ending it clears the agent from the unit."
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "landlord_id",
    "agent_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.landlord_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}