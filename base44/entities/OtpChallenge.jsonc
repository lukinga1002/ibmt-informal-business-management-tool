{
  "name": "OtpChallenge",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Who the challenge belongs to: a user id, or a namespaced reference such as registration:<landlord id>. Never a phone number."
    },
    "purpose": {
      "type": "string",
      "description": "e.g. payout_change, registration_otp, migration_otp"
    },
    "phone_masked": {
      "type": "string",
      "description": "Only the masked number is stored beside the challenge"
    },
    "code": {
      "type": "string",
      "description": "Simulation only, and only for the R7 payout demo: the code is shown so a demo can finish. Registration challenges never store a code, only code_hash."
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 of salt and code. The code itself is never stored and never returned to anyone but the party whose number it was sent to."
    },
    "salt": {
      "type": "string",
      "description": "Random salt generated per code, so one leaked hash cannot be reused against another challenge."
    },
    "channel": {
      "type": "string",
      "description": "How the code left the system: not_sent | in_app_demo | sms. Says plainly whether an SMS went out."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Five minutes after issue"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Fifteen minutes after the fifth wrong code"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_ref": {
      "type": "string",
      "description": "The record the challenge protects, e.g. a payout change id or a registration case reference"
    }
  },
  "required": [
    "subject_id",
    "purpose",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}