{
  "name": "ConditionReport",
  "type": "object",
  "properties": {
    "deposit_id": {
      "type": "string"
    },
    "tenancy_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "move_in",
        "move_out"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "move_in"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "landlord",
        "tenant",
        "agent"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "photo_uri": {
            "type": "string"
          }
        },
        "required": [
          "area",
          "condition"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_signature",
        "agreed"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "awaiting_signature"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party": {
            "type": "string",
            "enum": [
              "landlord",
              "tenant"
            ]
          },
          "method": {
            "type": "string"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "otp": {
      "type": "object",
      "description": "The one signing challenge outstanding for this report"
    },
    "agreed": {
      "type": "boolean",
      "default": false
    },
    "council_id": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "author_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}