{
  "name": "SimSettlement",
  "type": "object",
  "properties": {
    "payment_id": {
      "type": "string"
    },
    "council_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "council_amount": {
      "type": "number"
    },
    "partner_amount": {
      "type": "number"
    },
    "landlord_amount": {
      "type": "number"
    },
    "landlord_state": {
      "type": "string"
    },
    "settled_at": {
      "type": "string"
    },
    "income": {
      "type": "object"
    },
    "fee_revision_id": {
      "type": "string"
    },
    "fee_status": {
      "type": "string"
    }
  },
  "required": [
    "payment_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
