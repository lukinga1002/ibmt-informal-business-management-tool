{
  "name": "RentalUnit",
  "type": "object",
  "properties": {
    "unit_ref": {
      "type": "string",
      "description": "Serial reference, e.g. IBMT-UNIT-2026-002315",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "unit_name": {
      "type": "string",
      "description": "The name the landlord gave this unit, e.g. Nyumba ya mbele, Chumba A1. Used to pick the unit when renting it out."
    },
    "house_no": {
      "type": "string",
      "description": "House number on the street, as the landlord writes it"
    },
    "tenant_link_code": {
      "type": "string",
      "description": "Long random code behind the link the landlord shares with a tenant who is already in. The code is the only key to that unit's tenant form; it is never shown publicly."
    },
    "property_id": {
      "type": "string",
      "description": "The building this unit sits in",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "landlord_id": {
      "type": "string",
      "description": "User id of the landlord. Access anchor for every unit rule.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "landlord_name": {
      "type": "string"
    },
    "manager_id": {
      "type": "string",
      "description": "User id of a delegated property manager. Parked in Stage 1."
    },
    "agent_id": {
      "type": "string",
      "description": "Agent holding the active mandate. Cleared when the mandate ends, so an agent sees only mandated units."
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant on the active lease. Cleared when the tenancy ends.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "council_id": {
      "type": "string",
      "description": "Council the unit sits in. Bound in every council-scoped access rule.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "region": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "district": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ward": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "mtaa": {
      "type": "string",
      "description": "Street or mtaa level, the smallest area officials work in"
    },
    "street": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Anwani ya Makazi: full residential address. Never public, never in an aggregate."
    },
    "tanesco_meter": {
      "type": "string",
      "description": "TANESCO meter number for the unit"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "room",
        "flat",
        "house",
        "shop"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "default": "room"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "room",
        "shop",
        "plot"
      ],
      "description": "Earlier field, kept so existing records keep their meaning. unit_type is the one to read."
    },
    "bedrooms": {
      "type": "number"
    },
    "rent_amount": {
      "type": "number",
      "description": "Monthly rent as a whole number of shillings. Never a decimal."
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "occupancy": {
      "type": "string",
      "enum": [
        "vacant",
        "occupied"
      ],
      "enumColors": [
        "gray",
        "green"
      ],
      "default": "vacant",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "evidence_pending",
        "verified",
        "suspended"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "registered",
      "description": "Registration state. Distinct from verification_status, which records the ownership decision.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red"
      ],
      "default": "unverified",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "version": {
      "type": "number",
      "description": "Registration-state version incremented by the backend on every change"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client action key: a retried submit can never register the unit twice"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "unit_ref",
    "landlord_id",
    "council_id",
    "district",
    "ward"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.manager_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.landlord_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}