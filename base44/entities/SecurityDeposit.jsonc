{
  "name": "SecurityDeposit",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Deposit as a whole number of shillings, capped by the active policy version"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "held_by": {
      "type": "string",
      "enum": [
        "landlord",
        "agent",
        "tenant",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "description": "Who physically holds the money in Stage 1. IBMT never holds it."
    },
    "held_by_name": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stage1_record_only",
        "stage2_escrow"
      ],
      "enumColors": [
        "gray",
        "blue"
      ],
      "default": "stage1_record_only",
      "description": "Stage 1 records the deposit only. Escrow exists from Stage 2."
    },
    "status": {
      "type": "string",
      "enum": [
        "held",
        "partially_released",
        "released",
        "claimed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "purple"
      ],
      "default": "held"
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "recorded_by_id": {
      "type": "string"
    },
    "recorded_by_role": {
      "type": "string",
      "enum": [
        "landlord",
        "tenant"
      ]
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}