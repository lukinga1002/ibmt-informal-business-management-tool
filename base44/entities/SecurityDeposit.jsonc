{
  "name": "SecurityDeposit",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Held deposit as a whole number of shillings, capped by the active policy version"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "status": {
      "type": "string",
      "enum": [
        "held",
        "partially_released",
        "released",
        "claimed"
      ],
      "default": "held"
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    }
  },
  "required": [
    "tenancy_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}