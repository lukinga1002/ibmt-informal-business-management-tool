{
  "name": "Listing",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "unit_ref": {
      "type": "string"
    },
    "mandate_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "landlord_id": {
      "type": "string"
    },
    "consent_id": {
      "type": "string",
      "description": "The listings consent row that permits this listing. Withdrawing it hides the listing."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "listed",
        "paused",
        "let"
      ],
      "default": "draft"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when the unit passed ownership verification"
    },
    "headline": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "sw": {
          "type": "string"
        }
      }
    },
    "rent_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "TZS"
    },
    "council_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "mtaa": {
      "type": "string",
      "description": "Area shown to the public. Never a street, house number, plot number or pin."
    }
  },
  "required": [
    "unit_id",
    "status",
    "district",
    "ward"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "mtaa_officer"
              }
            },
            {
              "data.ward": {
                "$in": "{{user.data.ward_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "council_official"
              }
            },
            {
              "data.council_id": "{{user.data.council_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.landlord_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}