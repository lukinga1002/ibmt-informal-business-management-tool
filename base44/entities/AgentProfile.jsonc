{
  "name": "AgentProfile",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "User id of the agent"
    },
    "agent_name": {
      "type": "string"
    },
    "licence_no": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unlicensed",
        "licensed",
        "suspended"
      ],
      "default": "unlicensed"
    }
  },
  "required": [
    "agent_id",
    "agent_name",
    "district"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.ibmt_role": "district_official"
              }
            },
            {
              "data.district": "{{user.data.district}}"
            }
          ]
        },
        {
          "user_condition": {
            "data.ibmt_role": "tra_admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}