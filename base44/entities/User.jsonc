{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "ibmt_role": {
      "type": "string",
      "description": "IBMT platform role (separate from the Base44 admin/user role). Assigned by an administrator or a backend function; users cannot set their own.",
      "enum": [
        "operator",
        "consumer",
        "landlord",
        "tenant",
        "agent",
        "mtaa_officer",
        "council_official",
        "district_commissioner",
        "regional_commissioner",
        "district_official",
        "tra_admin",
        "ward_reporter",
        "super_admin"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "district": {
      "type": "string",
      "description": "Jurisdiction: district this official or subject operates in (e.g. Kinondoni, Ilala)",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "region": {
      "type": "string",
      "description": "Jurisdiction: region for a regional commissioner's aggregate view",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "council_id": {
      "type": "string",
      "description": "Jurisdiction: the one council a council official belongs to. Bound in every council-scoped access rule.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ward_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Jurisdiction: ward ids an mtaa officer or ward reporter covers",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}